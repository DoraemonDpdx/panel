APP_NAME=Astrelyse
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_THEME=pterodactyl
APP_TIMEZONE=UTC
APP_URL=http://panel.example.com
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=true

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=pterodactyl
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

HASHIDS_SALT=
HASHIDS_LENGTH=8

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Astrelyse"
# You should set this to your domain to prevent it defaulting to 'localhost', causing
# mail servers such as Gmail to reject your mail.
#
# @see: https://github.com/pterodactyl/panel/pull/3110
# MAIL_EHLO_DOMAIN=panel.example.com

# Google sign-in ("Continue with Google"). Create an OAuth client of type "Web application" in Google Cloud and add
# this panel's URL under Authorized JavaScript origins. Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# Discord sign-in ("Continue with Discord"). Create an application at discord.com/developers, add
# <panel url>/auth/login/discord/callback under OAuth2 > Redirects. Leave empty to hide the button.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Set to false to only sign in existing accounts instead of letting new Discord users create one.
DISCORD_ALLOW_REGISTRATION=true
# Optional: offer first-time Discord sign-ins to join your server. The bot must be in the server with the
# "Create Invitation" permission.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# CurseForge Core API key (https://console.curseforge.com) for the server Mods tab. Leave empty to offer Modrinth only.
CURSEFORGE_API_KEY=
