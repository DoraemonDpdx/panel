{
  "name": "astrelyse-customer-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Customer-facing Discord bot for Astrelyse: servers, billing, support and sign-in links, through the website only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "register": "tsx src/register.ts",
    "register:prod": "node dist/register.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
